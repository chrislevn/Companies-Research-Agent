# You do not need to edit this file by hand. Start the app (start.command /
# start.bat / start.sh) and the setup screen writes .env for you. This is here
# for server deployments and for anyone who prefers a text editor.

# --- Where triage runs -----------------------------------------------------
# anthropic = send message bodies to the Claude API (better judgement, costs money)
# ollama    = classify on this machine, nothing leaves it (free, needs a local model)
# vllm      = classify on a vLLM server you run (free, for when there is a GPU)
TRIAGE_BACKEND=anthropic
# Emails per model call. Lower it for local models — they get sloppy in long
# batches. Defaults to 10 for anthropic, 4 for ollama and vllm.
#TRIAGE_BATCH_SIZE=10

# Anthropic  (used when TRIAGE_BACKEND=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# Model used for triage. Opus 5 is the default; Haiku is cheaper for high volume.
TRIAGE_MODEL=claude-opus-5
# low | medium | high | xhigh | max  — triage is a cheap classification, low is plenty
TRIAGE_EFFORT=low

# --- Step 2: company research ----------------------------------------------
# Research reads public company websites and news, never your mail, so it runs
# on a hosted model even when triage is local.
RESEARCH_ENABLED=true
RESEARCH_PROVIDER=claude_web
RESEARCH_MODEL=claude-opus-5
# low | medium | high | xhigh | max. `low` is markedly faster and cheaper and
# still produces a usable brief; raise it for thinly-covered companies.
RESEARCH_EFFORT=medium
# Web searches and fetches are billed per use, so both ceilings are per run.
RESEARCH_MAX_SEARCHES=8
RESEARCH_MAX_COMPANIES=10
# Days before a cached company profile is looked up again. Research inside
# this window is never recomputed (see INSTRUCTIONS.md); --force overrides.
RESEARCH_TTL_DAYS=30

# --- Tool harness ----------------------------------------------------------
# What the agent is PERMITTED to do, independent of what any prompt asks for.
# This set is never in the model's context, so an injected instruction cannot
# grant itself a scope. Comma-separated; omit the line for the safe default.
#   research:read  mail:read  calendar:read  memory:write  brief:deliver
# brief:deliver is deliberately absent by default — nothing leaves this machine
# until you turn it on.
#TOOL_SCOPES=research:read,mail:read,calendar:read,memory:write
# Audit every tool call to the tool_calls table. Turning this off means a
# side-effecting tool runs unrecorded; leave it on.
TOOL_AUDIT_ENABLED=true
# Where anything may be sent. Enforced in the scopes gate for every tool that
# writes or sends, on the arguments, after the model has already decided what it
# wants — so no amount of persuasion in an email changes the outcome.
# Empty means "the mailbox owner only" (from USER_EMAILS); if that is empty too,
# nothing can be sent anywhere. It never means "anyone".
#ALLOWED_RECIPIENTS=you@example.com

# --- NVIDIA NeMo Guardrails (input rail, on by default) ----------------------
# A second opinion in front of triage: each inbound email is screened for
# prompt-injection attempts by the LOCAL Ollama model (never a hosted API —
# free, and the text stays on this machine) before triage reads it. The
# deterministic tool gates above remain the real wall; this adds a labelled
# verdict per message, on the dashboards as agent_guardrails_flagged_total.
# Needs the nemoguardrails package and a running Ollama; when either is
# missing the rail logs one warning and triage continues unscreened, so the
# default is safe on machines that cannot run it. Set false to opt out.
GUARDRAILS_ENABLED=true
# advisory = log + metric only. enforce = flagged mail is also downgraded to
# skip (safe direction — it can suppress a real lead, never invent one).
GUARDRAILS_MODE=advisory

# --- Step 3: calendar lookup -----------------------------------------------
# Reads the calendar.readonly scope that was already consented at sign-in — no
# new permission, no token to re-issue.
CALENDAR_ENABLED=true
CALENDAR_PROVIDER=google
# Far enough ahead to be worth preparing for, short enough that a standing
# weekly invite does not drown the meeting that matters.
CALENDAR_LOOKAHEAD_DAYS=30

# --- Step 5: delivery ------------------------------------------------------
# `file` writes approved briefs to out/briefs/ and nothing leaves the machine.
# This is the default on purpose: reading mail is what this agent is for,
# sending it is a different kind of act.
DELIVERY_PROVIDER=file
DELIVERY_DIR=out/briefs
# Only for DELIVERY_PROVIDER=gmail_send. Must be a SEPARATE mailbox with its own
# consent — the mailbox the agent reads is gmail.readonly and stays that way.
# Pointing this at a mailbox the agent reads is refused at startup.
#DELIVERY_ACCOUNT=sending-account-id
# Sending also needs TOOL_SCOPES to include brief:deliver, and the recipient to
# be in ALLOWED_RECIPIENTS. Both are checked on every delivery.

# --- Automatic checking ----------------------------------------------------
# The watcher re-checks the mailbox on an interval while the app is running.
WATCH_ENABLED=true
WATCH_INTERVAL_MINUTES=5

# --- Public demo / deployment ----------------------------------------------
# Hostnames the web interface will answer as, beyond localhost. Empty (the
# default) means the server refuses any request that does not arrive as
# localhost/127.0.0.1 — including through a tunnel — before serving anything.
# Set it when exposing the UI for a demo (see DEPLOYMENT.md). Comma-separated;
# `*.` matches one level of subdomain suffix.
#   Quick tunnel:  PUBLIC_HOSTS=*.trycloudflare.com
#   Named tunnel:  PUBLIC_HOSTS=demo.your-domain.com
#PUBLIC_HOSTS=
# Signup is locked by default: the first account created claims the instance
# and every later signup is refused. There is nothing to set to get that.
# Uncommenting the line below is the deliberate loosening — do it only for the
# window when visitors are meant to create accounts (e.g. graders trying the
# signup flow), and remember what it means: anyone who can sign up sees
# everything the agent has read and can run scans against your mailbox.
# Settings, the API key and purge stay with the first account — the one that
# claimed the instance. Comment it out again after.
#SIGNUP_OPEN=true
# Named-tunnel credential for docker-compose.deploy.yml (Cloudflare dashboard:
# Zero Trust → Networks → Tunnels). Only the cloudflared container reads it.
#TUNNEL_TOKEN=

# --- MCP server (see MCP.md) -------------------------------------------------
# Bearer token required by `mcp --http` mode. Unset means unauthenticated —
# fine on loopback, reckless behind a tunnel. Clients send it as
# `Authorization: Bearer <value>`. stdio mode never uses it: there, the client
# launches the process itself and the OS user is the authentication.
#MCP_AUTH_TOKEN=

# --- Observability ---------------------------------------------------------
METRICS_ENABLED=true
# Its own port, separate from the web interface (8765): the UI is token-gated
# and Prometheus cannot present a token.
METRICS_PORT=9464
# 127.0.0.1 like everything else this app serves. Prometheus running in a
# container cannot reach that — set 0.0.0.0 deliberately if you want it to.
METRICS_HOST=127.0.0.1
# Tracing needs a collector listening. Off by default so a missing one is never
# the reason the agent will not start.
TRACING_ENABLED=false
OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Langfuse: the prompt and the completion side by side, which is the one
# question metrics and traces cannot answer. Needs its own stack:
#   docker compose -f docker-compose.langfuse.yml up -d
# The keys below match the LANGFUSE_INIT_* block in that file, so they are
# already correct on first boot. Port 3001, because Grafana has 3000.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-companies-research-agent
LANGFUSE_SECRET_KEY=sk-lf-companies-research-agent
# What actually gets sent. Off means model, tokens, cost, latency, batch size
# and confidence — enough to see triage getting worse or spend drifting, and it
# carries no message text. On also sends prompts and completions, with
# addresses hashed: better for debugging one bad verdict, and a copy of your
# mail in a Postgres container. Leave it off unless you are mid-investigation.
LANGFUSE_CAPTURE_CONTENT=false
# Serve the triage/research prompts FROM Langfuse prompt management instead of
# the built-ins. `./start.sh langfuse sync` versions the built-ins there; after
# that, editing a prompt in the Langfuse UI and moving the label rolls it out
# (or back) with no deploy. Any fetch problem falls back to the file or the
# built-in, so this can never stop a scan.
LANGFUSE_PROMPTS_ENABLED=false
LANGFUSE_PROMPT_LABEL=production

# --- Prompts ---------------------------------------------------------------
# `./start.sh prompts research --write` drops the built-in prompt in here to
# edit; delete the file to go back to the default.
PROMPTS_DIR=prompts
# Appended to the prompt in use, for house rules you want *alongside* the
# default rather than instead of it. Keep it to a line or two.
#RESEARCH_PROMPT_EXTRA=We sell to logistics firms — always check fleet size.
#TRIAGE_PROMPT_EXTRA=Bank and utility notifications are `automated`, never `customer`.

# Local model  (used when TRIAGE_BACKEND=ollama; install from ollama.com)
OLLAMA_HOST=http://localhost:11434
# Prefer a general instruct model with solid Vietnamese — coder-tuned models
# mislabel business email. Pull it first: `ollama pull qwen3:8b`
OLLAMA_MODEL=qwen3:8b
# Ollama's default context is far too small for a batch of emails plus the
# schema, and it drops the overflow silently rather than erroring.
OLLAMA_NUM_CTX=16384
# Seconds to wait for a local generation before giving up on the batch.
OLLAMA_TIMEOUT=600

# vLLM server  (used when TRIAGE_BACKEND=vllm)
# The other self-hosted option, for when there is a real GPU — vLLM's
# continuous batching makes a large scan several times faster than Ollama on
# the same card. Start it with `vllm serve Qwen/Qwen3-8B` (pip install vllm),
# on this machine or on a GPU box you reach over a private network. Mail goes
# to this address and nowhere else.
VLLM_BASE_URL=http://localhost:8000/v1
# Must match the model name the server was started with.
VLLM_MODEL=Qwen/Qwen3-8B
# Only if the server was started with --api-key. Sent as a Bearer token.
#VLLM_API_KEY=
# Seconds to wait for a generation before giving up on the batch.
VLLM_TIMEOUT=600

# --- Solo mode (default) ---------------------------------------------------
# One Gmail mailbox, browser consent once. Nothing else to configure.
GOOGLE_CREDENTIALS_FILE=credentials/client_secret.json
GOOGLE_TOKEN_FILE=credentials/token.json

# --- Chat: Google Drive + long-term memory (`chat` command) ----------------
# Drive uses YOUR account by default: the OAuth client above, consented once in
# a browser, cached as a separate Drive-only token (credentials/token-drive.json)
# so the Gmail token keeps its scopes untouched. Enable the Drive API for the
# same Cloud project first. For headless deployments, a service-account JSON is
# the alternative — share a folder with its address; setting this is the opt-in.
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# Limit listings to one folder. Empty = everything the credential can see.
# GOOGLE_DRIVE_FOLDER_ID=
# Embeddings for long-term memory always run on Ollama, so remembered content
# never leaves this machine. Pull the model once: `ollama pull nomic-embed-text`.
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Team / enterprise mode ------------------------------------------------
# Point this at a JSON file to watch several mailboxes across Gmail,
# Microsoft 365 and IMAP. See accounts.example.json. Leave unset for solo mode.
# ACCOUNTS_FILE=accounts.json

# Secrets referenced from accounts.json as env:NAME live here (or in your
# secret manager — the app only ever sees the resolved value).
# MS_CLIENT_SECRET=
# ZOHO_APP_PASSWORD=

# Local state
DB_PATH=data/agent.db

# How far back each check looks, in days
SCAN_DAYS=1

# Your own address(es), comma separated. Mail you sent is ignored.
USER_EMAILS=you@example.com

# Domains that are never "new business contacts" (your own company, vendors you know)
IGNORED_DOMAINS=example.com
